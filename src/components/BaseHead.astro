---
import '../styles/global.css';
import { getLang, getAlternateUrl } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og-image.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const lang = getLang(Astro.url.pathname);
const alternatePath = getAlternateUrl(Astro.url.pathname);
const alternateURL = new URL(alternatePath, Astro.site);
const alternateLang = lang === 'es' ? 'fr' : 'es';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.ico" />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang={lang} href={canonicalURL} />
<link rel="alternate" hreflang={alternateLang} href={alternateURL} />
<link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
<meta name="generator" content={Astro.generator} />
<meta name="google-site-verification" content="Ny3NXMQvDOgd4RSHeoXqmbokXbp-IzOKL2sisHehsYw" />

<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
