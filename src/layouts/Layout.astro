---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getLang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
} = Astro.props;

const pageTitle = (title === SITE_TITLE || title.includes(SITE_TITLE)) ? title : `${title} — ${SITE_TITLE}`;
const lang = getLang(Astro.url.pathname);
---

<html lang={lang}>
  <head>
    <BaseHead title={pageTitle} description={description} image={image} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
