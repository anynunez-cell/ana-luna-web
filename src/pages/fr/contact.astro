---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Contact" description="Écrire à Ana Luna — collaborations, presse, événements.">

  <h1 class="section-title">Contact</h1>
  <hr class="section-divider" />

  <div class="contacto-wrap">
    <p class="contacto-intro">
      Une proposition de collaboration, une question de presse ou simplement envie d'écrire&nbsp;?
      Utilisez le formulaire et je vous répondrai dans les plus brefs délais.
    </p>

    <form
      name="contact-fr"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="contacto-form"
    >
      <input type="hidden" name="form-name" value="contact-fr" />
      <p class="hidden"><label>Ne pas remplir : <input name="bot-field" /></label></p>

      <div class="form-row">
        <label for="nom">Nom</label>
        <input type="text" id="nom" name="nom" required placeholder="Votre nom" />
      </div>

      <div class="form-row">
        <label for="email">Courriel</label>
        <input type="email" id="email" name="email" required placeholder="vous@courriel.com" />
      </div>

      <div class="form-row">
        <label for="sujet">Sujet</label>
        <input type="text" id="sujet" name="sujet" placeholder="Collaboration, presse, autre…" />
      </div>

      <div class="form-row">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required placeholder="Votre message…"></textarea>
      </div>

      <button type="submit" class="btn btn-primary">Envoyer</button>
    </form>
  </div>

</Layout>

<style>
  .contacto-wrap {
    max-width: 580px;
    margin: 0 auto;
  }
  .contacto-intro {
    text-align: center;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
  }
  .hidden { display: none; }
  .contacto-form {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }
  input, textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.65rem 0.9rem;
    border: 1.5px solid rgba(61,43,107,0.25);
    border-radius: 4px;
    background: #fff;
    color: var(--color-text);
    transition: border-color 0.2s;
    resize: vertical;
  }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--color-secondary);
  }
  button[type="submit"] {
    align-self: flex-start;
    margin-top: 0.5rem;
  }
</style>
