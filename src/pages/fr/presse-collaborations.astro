    description: 'Membre.',
    lien: 'https://www.uneq.qc.ca',
    lienLabel: 'uneq.qc.ca ↗',
  },
  {
    nom: 'Arrimage — Îles-de-la-Madeleine',
    description: 'Membre artiste de l\'organisme de développement culturel des Îles-de-la-Madeleine.',
