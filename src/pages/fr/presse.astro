---
import Layout from '../../layouts/Layout.astro';

const evenements = [
  {
    date: 'Octobre 2026',
    nom: 'Feria Iberoamericana del Libro en Canadá',
    lieu: 'Ottawa',
    participation: [
      'Présentation de El árbol y la escarcha (première anthologie cubano-canadienne) et Picadillo a la miseria.',
      'Stand de Cristálida Ediciones comme éditeur exposant.',
    ],
    lien: 'https://www.filibrocanada.com',
    prochain: true,
  },
  {
    date: 'Juin 2026',
    nom: 'Festival Littéraire des Îles — Portages',
    lieu: 'Îles-de-la-Madeleine, Québec',
    participation: [
      'Animatrice de la conférence «Mers jumelles : imaginaires insulaires croisés entre les Îles-de-la-Madeleine et Cuba».',
      'Lecture lors de l\'événement d\'ouverture.',
      'Cercle d\'autrices aux côtés de Naomi Fontaine, Juli Delporte et Claire Vigneau.',
      'Lecture jeunesse de Cuentos para Bárbara de Reyna Esperanza Cruz.',
    ],
    lien: 'https://www.sitedelacote.ca/portages',
    prochain: true,
  },
  {
    date: '2024',
    nom: 'FILibro Canadá',
    lieu: null,
    participation: [
      'Cristálida Ediciones comme éditeur exposant.',
    ],
    lien: 'https://www.filibrocanada.com/cristalida-ediciones.html',
    prochain: false,
  },
  {
    date: '2024',
    nom: 'Feria del libro Ser y estar en español',
    lieu: 'Québec',
    participation: [
      'Salon qui célèbre la langue espagnole au Québec.',
    ],
    lien: 'https://www.seryestar.ca/événements',
    prochain: false,
  },
  {
    date: null,
    nom: 'Feria Internacional del Libro de La Habana',
    lieu: null,
    participation: [
      'La foire que je porte toujours dans le cœur.',
    ],
    lien: null,
    prochain: false,
  },
];

const medias = [
  {
    media: 'Hablemos Escritoras',
    description: 'Podcast et encyclopédie d\'écrivaines en espagnol',
    citation: '«Crónicas domésticas es una joya de la narrativa breve que convierte lo cotidiano en una fuente inagotable de revelaciones.»',
    details: 'Minicritique publiée en novembre 2025. Disponible aussi : Épisode 673 du podcast.',
    liens: [
      { label: 'Voir la critique', url: 'https://www.hablemosescritoras.org/posts/7351' },
      { label: 'Profil complet', url: 'https://www.hablemosescritoras.org/writers/4810' },
    ],
  },
];

const communautes = [
  {
    nom: 'Club d\'écriture Fuentetaja',
    description: 'Un club d\'écriture ouvert à tous, avec concours et lectures. Vous pouvez y lire quelques-unes de mes nouvelles et participer.',
    lien: 'https://clubdeescritura.com/perfil/178035/ana-luna-2/#folder-220821',
    lienLabel: 'Voir le profil ↗',
  },
  {
    nom: 'Proyecto Sherezade — Université du Manitoba',
    description: 'Un projet qui permet de lire des nouvelles de toute l\'Amérique hispanophone et de soumettre vos propres textes. J\'ai eu l\'honneur d\'y collaborer.',
    lien: 'https://home.cc.umanitoba.ca/~fernand4/index.html',
    lienLabel: 'Visiter le projet ↗',
  },
];
---

<Layout title="Presse et événements" description="Événements, presse et communautés littéraires d'Ana Luna — Ana Núñez González.">

  <h1 class="section-title">Presse et événements</h1>
  <hr class="section-divider" />

  <!-- SECTION 1: ÉVÉNEMENTS -->
  <section class="bloque">
    <h2 class="bloque-titulo">Événements et participations</h2>
    <div class="eventos-lista">
      {evenements.map((ev) => (
        <article class="evento-card">
          <div class="evento-fecha-col">
            {ev.date && <span class="evento-fecha">{ev.date}</span>}
            {ev.prochain && <span class="evento-badge">À venir</span>}
          </div>
          <div class="evento-info">
            <h3 class="evento-nombre">{ev.nom}</h3>
            {ev.lieu && <p class="evento-lugar">{ev.lieu}</p>}
            <ul class="evento-participacion">
              {ev.participation.map((p) => <li>{p}</li>)}
            </ul>
            {ev.lien && (
              <a href={ev.lien} target="_blank" rel="noopener" class="evento-link">Voir l'événement ↗</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- SECTION 2: DANS LES MÉDIAS -->
  <section class="bloque">
    <h2 class="bloque-titulo">Dans les médias</h2>
    <div class="medios-grid">
      {medias.map((item) => (
        <article class="medio-card">
          <p class="medio-nombre">{item.media}</p>
          <p class="medio-desc">{item.description}</p>
          {item.citation && <blockquote class="medio-cita">{item.citation}</blockquote>}
          <p class="medio-detalles">{item.details}</p>
          <div class="medio-enlaces">
            {item.liens.map((e) => (
              <a href={e.url} target="_blank" rel="noopener" class="btn btn-outline btn-sm">{e.label} ↗</a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- SECTION 3: COMMUNAUTÉS LITTÉRAIRES -->
  <section class="bloque">
    <h2 class="bloque-titulo">Communautés littéraires</h2>
    <ul class="comunidades-lista">
      {communautes.map((c) => (
        <li class="comunidad-item">
          <h3 class="comunidad-nombre">{c.nom}</h3>
          <p class="comunidad-desc">{c.description}</p>
          <a href={c.lien} target="_blank" rel="noopener" class="evento-link">{c.lienLabel}</a>
        </li>
      ))}
    </ul>
  </section>

</Layout>

<style>
  .bloque {
    margin-bottom: 4rem;
  }
  .bloque-titulo {
    font-size: 1.5rem;
    color: var(--color-primary);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 0.4rem;
    margin-bottom: 1.8rem;
    display: inline-block;
  }

  .eventos-lista {
    display: flex;
    flex-direction: column;
  }
  .evento-card {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(61,43,107,0.12);
  }
  .evento-card:last-child { border-bottom: none; }
  @media (max-width: 600px) {
    .evento-card { grid-template-columns: 1fr; gap: 0.5rem; }
  }
  .evento-fecha-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.15rem;
  }
  .evento-fecha {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-secondary);
    line-height: 1.3;
  }
  .evento-badge {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.18rem 0.45rem;
    border-radius: 3px;
    align-self: flex-start;
  }
  .evento-nombre {
    font-size: 1.15rem;
    margin: 0 0 0.2rem;
  }
  .evento-lugar {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0 0 0.6rem;
  }
  .evento-participacion {
    margin: 0 0 0.75rem;
    padding-left: 1.2rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
  }
  .evento-participacion li { margin-bottom: 0.25rem; }
  .evento-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-secondary);
  }
  .evento-link:hover { color: var(--color-accent); }

  .medios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .medio-card {
    border: 1px solid rgba(61,43,107,0.15);
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    background: #fff;
    box-shadow: var(--box-shadow);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .medio-nombre {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
  }
  .medio-desc {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0;
    font-style: italic;
  }
  .medio-cita {
    margin: 0.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-style: italic;
    color: var(--color-text);
    line-height: 1.6;
  }
  .medio-detalles {
    font-size: 0.9rem;
    color: var(--color-text);
    margin: 0;
  }
  .medio-enlaces {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .btn-sm { padding: 0.45rem 1rem; font-size: 0.82rem; }

  .comunidades-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .comunidad-item {
    border-left: 3px solid var(--color-secondary);
    padding-left: 1.25rem;
  }
  .comunidad-nombre {
    font-size: 1.15rem;
    margin: 0 0 0.3rem;
  }
  .comunidad-desc {
    font-size: 0.95rem;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    line-height: 1.65;
  }
</style>
